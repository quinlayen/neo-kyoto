    {
      "type": "text",
      "id": "terminal_content",
      "x": 652, "y": 40,
      "width": 300, "height": 300,
      "text": "contractor@grid:~$ ls -a /opt/grid\n.  ..  .commands.txt\n.repair_protocol.txt\n\ncontractor@grid:~$ cat \\\n  /opt/grid/.repair_protocol.txt\nREPAIR PROTOCOL\n───────────────\nbroken = get_broken_sectors()\nfor sector in broken:\n    repair(sector)\n\ncontractor@grid:~$ _",
      "originalText": "contractor@grid:~$ ls -a /opt/grid\n.  ..  .commands.txt\n.repair_protocol.txt\n\ncontractor@grid:~$ cat \\\n  /opt/grid/.repair_protocol.txt\nREPAIR PROTOCOL\n───────────────\nbroken = get_broken_sectors()\nfor sector in broken:\n    repair(sector)\n\ncontractor@grid:~$ _",
      "fontSize": 11,
      "fontFamily": 3,
