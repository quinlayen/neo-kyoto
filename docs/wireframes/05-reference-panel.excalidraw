    {
      "type": "text",
      "id": "dimmed_code_lines",
      "x": 30, "y": 60,
      "width": 600, "height": 280,
      "text": " 1  # Grid Restoration\n 2  # Sector 14-B\n 3  # ──────────────────\n 4\n 5  broken = get_broken_sectors()\n 6  for sector in broken:\n 7      repair(sector)\n 8\n 9  status = check_grid()\n10  if status == \"stable\":\n11      report(\"all clear\")\n12\n13\n14\n15\n16",
      "originalText": " 1  # Grid Restoration\n 2  # Sector 14-B\n 3  # ──────────────────\n 4\n 5  broken = get_broken_sectors()\n 6  for sector in broken:\n 7      repair(sector)\n 8\n 9  status = check_grid()\n10  if status == \"stable\":\n11      report(\"all clear\")\n12\n13\n14\n15\n16",
